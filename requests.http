### 27. Get All Films
GET {{baseUrl}}/api/films

### 28. Get Film by ID (Update ID as needed)
GET {{baseUrl}}/api/films/{{filmId}}

### 29. Get Films by Director
GET {{baseUrl}}/api/films/director/1

### 30. Get Films by Category
GET {{baseUrl}}/api/films/category/3

### 31. Update Film
PUT {{baseUrl}}/api/films/{{filmId}}
Content-Type: {{contentType}}

{
  "title": "Inception - Extended Edition",
  "releaseYear": "2010-07-16",
  "duration": 160,
  "synopsis": "A thief who steals corporate secrets through the use of dream-sharing technology is given the inverse task of planting an idea into the mind of a C.E.O. Extended with deleted scenes.",
  "rating": 9.0,
  "directorId": 1,
  "categoryId": 3
}

### 32. Delete Film
DELETE {{baseUrl}}/api/films/{{filmId}}

###############################################################################
### VALIDATION TESTS (Should return 400 Bad Request)
###############################################################################

### 33. Create Category - Missing Name (Invalid)
POST {{baseUrl}}/api/categories
Content-Type: {{contentType}}

{
  "description": "This should fail - no name provided"
}

### 34. Create Category - Name Too Short (Invalid)
POST {{baseUrl}}/api/categories
Content-Type: {{contentType}}

{
  "name": "A",
  "description": "Name too short - should fail"
}

### 35. Create Director - Invalid Birth Year (Invalid)
POST {{baseUrl}}/api/directors
Content-Type: {{contentType}}

{
  "name": "Test Director",
  "nationality": "American",
  "birthYear": 1800
}

### 36. Create Film - Missing Required Fields (Invalid)
POST {{baseUrl}}/api/films
Content-Type: {{contentType}}

{
  "title": "Incomplete Film"
}

### 37. Create Film - Invalid Rating (Invalid)
POST {{baseUrl}}/api/films
Content-Type: {{contentType}}

{
  "title": "Bad Rating Film",
  "releaseYear": "2023-01-01",
  "duration": 120,
  "synopsis": "This film has an invalid rating",
  "rating": 15.0,
  "directorId": 1,
  "categoryId": 1
}

###############################################################################
### ERROR HANDLING TESTS
###############################################################################

### 38. Get Non-Existent Category (Should return 404)
GET {{baseUrl}}/api/categories/999

### 39. Get Non-Existent Director (Should return 404)
GET {{baseUrl}}/api/directors/999

### 40. Get Non-Existent Film (Should return 404)
GET {{baseUrl}}/api/films/00000000-0000-0000-0000-000000000000

### 41. Create Duplicate Category (Should fail)
POST {{baseUrl}}/api/categories
Content-Type: {{contentType}}

{
  "name": "Action",
  "description": "This should fail - duplicate name"
}

### 42. Delete Non-Existent Category (Should return 404)
DELETE {{baseUrl}}/api/categories/999

